# El repo es público: solo lleva lo necesario para que corran los cron (workflows, scripts y sus
# insumos), el historial de descargas y los productos publicados en data/out/ y parroquias/.
# Todo lo demás queda solo en la carpeta local y se entrega al equipo por correo.

# Sistema y Python
.DS_Store
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
Thumbs.db
desktop.ini

# Secretos: solo por variables de entorno
.env

